# ============================================================
# IronPeak Fitness Studio — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER put real API keys in this file.
# ============================================================

# Django Core
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# AI Chatbot (Grok — https://console.groq.com/)
GROK_API_KEY=gsk_your_grok_api_key_here

# Google Gemini API (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
# Model your key is provisioned for (e.g. gemini-1.3-pro-preview, gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT=20

# Stripe Payment Gateway (https://dashboard.stripe.com/apikeys)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
